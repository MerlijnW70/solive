{
  "name": "@intent-engine/cli",
  "version": "0.1.54",
  "description": "Command line and MCP server for the intent engine on Solana",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MerlijnW70/solive.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/MerlijnW70/solive#readme",
  "bugs": {
    "url": "https://github.com/MerlijnW70/solive/issues"
  },
  "type": "module",
  "files": [
    "dist/src",
    "assets/viperjs-judge.wasm",
    "assets/viperjs-judge.sha256"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "intent-engine": "./dist/src/bin.js"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --fsModuleCache --config ./vitest.setup.ts"
  },
  "dependencies": {
    "@intent-engine/client": "workspace:*",
    "@intent-engine/core": "workspace:*",
    "@intent-engine/solver": "workspace:*",
    "@modelcontextprotocol/server": "2.3.1",
    "@solana-program/system": "0.14.1",
    "@solana-program/token": "0.16.1",
    "@solana/kit": "8.4.0"
  },
  "devDependencies": {
    "@ledgerhq/hw-transport": "6.36.0",
    "@ledgerhq/hw-transport-mocker": "6.35.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "26.6.4",
    "fast-check": "4.10.2",
    "litesvm": "1.5.0",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
