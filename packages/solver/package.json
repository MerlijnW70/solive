{
  "name": "@intent-engine/solver",
  "version": "0.1.45",
  "description": "A solver that fills intent engine intents at a profit",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MerlijnW70/solive.git",
    "directory": "packages/solver"
  },
  "homepage": "https://github.com/MerlijnW70/solive#readme",
  "bugs": {
    "url": "https://github.com/MerlijnW70/solive/issues"
  },
  "type": "module",
  "files": [
    "dist/src"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --fsModuleCache --config ./vitest.setup.ts"
  },
  "dependencies": {
    "@intent-engine/core": "workspace:*",
    "@solana-program/system": "0.14.1",
    "@solana-program/token": "0.16.1",
    "@solana/kit": "8.4.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "fast-check": "4.10.2",
    "litesvm": "1.5.0",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
