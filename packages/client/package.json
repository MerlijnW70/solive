{
  "name": "@intent-engine/client",
  "version": "0.1.19",
  "description": "Runtime client for the intent engine on Solana: transport, confirmation, account readers and intent notifications",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./svm": {
      "types": "./dist/src/svm.d.ts",
      "import": "./dist/src/svm.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --fsModuleCache"
  },
  "dependencies": {
    "@intent-engine/core": "workspace:*",
    "@solana-program/system": "0.14.1",
    "@solana-program/token": "0.16.1",
    "@solana/kit": "8.4.0"
  },
  "peerDependencies": {
    "litesvm": "^1.5.0"
  },
  "peerDependenciesMeta": {
    "litesvm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "litesvm": "1.5.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
