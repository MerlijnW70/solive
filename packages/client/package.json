{
  "name": "@intent-engine/client",
  "version": "0.1.55",
  "description": "Runtime client for the intent engine on Solana: transport, confirmation, account readers and intent notifications",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MerlijnW70/solive.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/MerlijnW70/solive#readme",
  "bugs": {
    "url": "https://github.com/MerlijnW70/solive/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "program/intent_engine.so"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./node": {
      "types": "./dist/src/node.d.ts",
      "import": "./dist/src/node.js",
      "default": "./dist/src/node.js"
    },
    "./internal": {
      "types": "./dist/src/internal.d.ts",
      "import": "./dist/src/internal.js",
      "default": "./dist/src/internal.js"
    },
    "./svm": {
      "types": "./dist/src/svm.d.ts",
      "import": "./dist/src/svm.js",
      "default": "./dist/src/svm.js"
    },
    "./testing": {
      "types": "./dist/src/testing.d.ts",
      "import": "./dist/src/testing.js",
      "default": "./dist/src/testing.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --fsModuleCache"
  },
  "dependencies": {
    "@intent-engine/core": "workspace:*",
    "@solana-program/system": "0.14.1",
    "@solana-program/token": "0.16.1"
  },
  "peerDependencies": {
    "@ledgerhq/hw-app-solana": "7.12.0",
    "@ledgerhq/hw-transport-node-hid-noevents": "6.36.0",
    "@solana/kit": "^8.4.0",
    "litesvm": "^1.5.0"
  },
  "peerDependenciesMeta": {
    "@ledgerhq/hw-app-solana": {
      "optional": true
    },
    "@ledgerhq/hw-transport-node-hid-noevents": {
      "optional": true
    },
    "litesvm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ledgerhq/hw-app-solana": "7.12.0",
    "@ledgerhq/hw-transport-node-hid-noevents": "6.36.0",
    "@solana/kit": "8.4.0",
    "@types/node": "26.6.4",
    "esbuild": "0.28.2",
    "litesvm": "1.5.0",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
