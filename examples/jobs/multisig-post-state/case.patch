From: MerlijnW70 <196433316+MerlijnW70@users.noreply.github.com>
Date: Mon, 26 Oct 2026 07:04:41 +0100
Subject: [PATCH] Hunt: MS-2 buffer rewritten inside the IDL update proposal

---
 .../test/hunt/ms-write-before-set.test.ts     | 110 ++++++++++++++++++
 1 file changed, 110 insertions(+)
 create mode 100644 packages/multisig/test/hunt/ms-write-before-set.test.ts

diff --git a/packages/multisig/test/hunt/ms-write-before-set.test.ts b/packages/multisig/test/hunt/ms-write-before-set.test.ts
new file mode 100644
index 0000000..0772c06
--- /dev/null
+++ b/packages/multisig/test/hunt/ms-write-before-set.test.ts
@@ -0,0 +1,110 @@
+import { deflateSync, inflateSync } from "node:zlib";
+import { AccountRole, type Address, type Instruction } from "@solana/kit";
+import { beforeAll, describe, expect, it } from "vitest";
+import { SYSTEM_PROGRAM } from "../../src/layout.js";
+import { EXIT_OK } from "../../src/main.js";
+import { canonicalMetadata, PROGRAM_METADATA } from "../../src/program-metadata-layout.js";
+import { ENGINE_PROGRAM, programDataOf } from "../../src/squads.js";
+import { craftVault, multisig, openSvm, s } from "../multisig-world.js";
+import {
+  concat,
+  digest,
+  engineUpgradedBy,
+  idlBuffer,
+  loadProgramMetadata,
+  LOCAL_HASH,
+  LOCAL_IDL,
+  meta,
+  placeMetadata,
+  rentOf,
+  u64,
+  writeBuffer,
+} from "../program-metadata-world.js";
+
+beforeAll(async () => {
+  await openSvm();
+  loadProgramMetadata();
+  s.svm.warpToSlot(10n);
+});
+
+const OLD_IDL = LOCAL_IDL.subarray(0, Math.floor(LOCAL_IDL.length / 2));
+
+const u32 = (value: number) => {
+  const out = new Uint8Array(4);
+  new DataView(out.buffer).setUint32(0, value, true);
+  return out;
+};
+
+const onChainIdl = (at: Address): Uint8Array => {
+  const held = s.account(at);
+  if (!held.exists) {
+    throw new Error(`${at} is closed`);
+  }
+  const length = new DataView(held.data.buffer, held.data.byteOffset, held.data.byteLength).getUint32(87, true);
+  return new Uint8Array(inflateSync(held.data.subarray(96, 96 + length)));
+};
+
+function sameSizeForgery(content: Uint8Array): Uint8Array {
+  const size = deflateSync(content).length;
+  for (let at = content.length - 2; at > 0; at -= 1) {
+    const byte = content[at] ?? 0;
+    if (byte < 0x61 || byte > 0x7a) {
+      continue;
+    }
+    const forged = Uint8Array.from(content);
+    forged[at] = byte === 0x78 ? 0x79 : 0x78;
+    if (deflateSync(forged).length === size) {
+      return forged;
+    }
+  }
+  throw new Error("no forgery of the same compressed size");
+}
+
+describe("an IDL update proposal that rewrites the reviewed buffer before it sets the IDL", () => {
+  it("MS-2 sets the IDL whose sha256 approve showed and execute --expect-buffer-hash compared", async () => {
+    const m = await multisig("ms-idl", 2);
+    s.fund(m.vault);
+    await engineUpgradedBy(m.vault);
+    const metadata = await placeMetadata({ content: OLD_IDL });
+    expect(metadata).toBe(await canonicalMetadata(ENGINE_PROGRAM));
+    const deployer = await s.member("ms-idl-deployer.json");
+    const buffer = await idlBuffer(deployer, LOCAL_IDL, m.vault);
+    const forged = sameSizeForgery(LOCAL_IDL);
+    expect(digest(forged)).not.toBe(LOCAL_HASH);
+    const rogue = await s.member("ms-idl-rogue.json");
+    const source = await writeBuffer(rogue, deflateSync(forged));
+
+    const topUp: Instruction = {
+      programAddress: SYSTEM_PROGRAM,
+      accounts: [meta(m.vault, AccountRole.WRITABLE_SIGNER), meta(metadata, AccountRole.WRITABLE)],
+      data: concat([2, 0, 0, 0], u64(rentOf(deflateSync(LOCAL_IDL).length) - rentOf(deflateSync(OLD_IDL).length))),
+    };
+    const overwrite: Instruction = {
+      programAddress: PROGRAM_METADATA,
+      accounts: [meta(buffer, AccountRole.WRITABLE), meta(m.vault, AccountRole.READONLY_SIGNER), meta(source)],
+      data: concat([0], u32(0)),
+    };
+    const setData: Instruction = {
+      programAddress: PROGRAM_METADATA,
+      accounts: [
+        meta(metadata, AccountRole.WRITABLE),
+        meta(m.vault, AccountRole.READONLY_SIGNER),
+        meta(buffer, AccountRole.WRITABLE),
+        meta(ENGINE_PROGRAM),
+        meta(await programDataOf(ENGINE_PROGRAM)),
+      ],
+      data: Uint8Array.from([3, 1, 2, 1, 0]),
+    };
+    const index = await craftVault(m, [topUp, overwrite, setData]);
+
+    const on = ["--multisig", m.address, "--index", index.toString()];
+    for (const name of ["b", "c"]) {
+      const approved = await s.cli("approve", ...on, "--keypair", m.file(name), "--yes");
+      expect([approved.code, approved.err, approved.json()["buffer_hash"]]).toEqual([EXIT_OK, "", LOCAL_HASH]);
+    }
+    const executed = await s.cli("execute", ...on, "--expect-buffer-hash", LOCAL_HASH, "--keypair", m.file("c"), "--yes");
+    expect([executed.code, executed.err]).toEqual([EXIT_OK, ""]);
+    const set = digest(onChainIdl(metadata));
+    expect(set === LOCAL_HASH ? "the approved IDL" : `an IDL with sha256 ${set}, not the approved ${LOCAL_HASH}`).toBe("the approved IDL");
+  });
+});
