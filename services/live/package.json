{
  "name": "@intent-engine/live",
  "version": "0.0.0",
  "private": true,
  "description": "Devnet feed function that reads the program's recent activity for the live page",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --fsModuleCache"
  },
  "dependencies": {
    "@intent-engine/client": "workspace:*",
    "@intent-engine/core": "workspace:*",
    "@solana/kit": "8.4.0",
    "@vercel/functions": "3.10.1"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
